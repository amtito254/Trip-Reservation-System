# Block direct download of setup/config files and stop folder listings
Options -Indexes

<FilesMatch "(?i)(^demo_coaches_config\.php$|\.sql$|\.md$|^config\.sample\.php$|^LICENSE$|^\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
